package ru.mirea.pr1;

public class Task6 {
    public static void main(String[] args) {
        System.out.println("Первые 10 чисел гармонического ряда:");
        double harmonicSum = 0.0;

        for (int i = 1; i <= 10; i++) {
            double term = 1.0 / i;       // очередной член ряда
            harmonicSum += term;          // накапливаем частичную сумму

            System.out.printf(
                    "H(%2d) = 1/%-2d = %.4f  (частичная сумма: %.4f)%n",
                    i, i, term, harmonicSum
            );
        }
    }
}

package ru.mirea.pr1;

import java.util.Scanner;

public class Task7 {
    // Метод класса для вычисления факториала
    public static long factorial(int n) {
        if (n < 0) {
            throw new IllegalArgumentException(
                    "Факториал отрицательного числа не определён");
        }
        long result = 1;
        for (int i = 2; i <= n; i++) {
            result *= i;
        }
        return result;
    }

    // main: проверка работы метода
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // 1. Ввод числа с клавиатуры
        System.out.print("Введите целое неотрицательное число: ");
        int n = sc.nextInt();

        // 2. Вызов метода и вывод результата
        long fact = factorial(n);
        System.out.println(n + "! = " + fact);

        // 3. Проверка метода для диапазона чисел
        System.out.println("\nПроверка работы метода:");
        for (int i = 0; i <= 10; i++) {
            System.out.println(i + "! = " + factorial(i));
        }

        sc.close();
    }
}
