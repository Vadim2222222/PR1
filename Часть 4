package computer;

public class Computer {
    // Поля-компоненты
    private Brand brand;          // марка (enum)
    private Processor processor;  // процессор
    private Memory memory;        // память
    private Monitor monitor;      // монитор

    // Конструктор
    public Computer(Brand brand, Processor processor,
                    Memory memory, Monitor monitor) {
        this.brand = brand;
        this.processor = processor;
        this.memory = memory;
        this.monitor = monitor;
    }

    // Геттеры
    public Brand getBrand() { return brand; }
    public Processor getProcessor() { return processor; }
    public Memory getMemory() { return memory; }
    public Monitor getMonitor() { return monitor; }

    // Полезные методы

    // Общая «мощность» — сумма ядер × частота (простая эвристика)
    public double getPerformanceScore() {
        return processor.getCores() * processor.getFrequencyGHz();
    }

    // Проверка: подходит ли для современных игр (простая эвристика)
    public boolean isGamingReady() {
        return processor.getCores() >= 8
                && processor.getFrequencyGHz() >= 3.0
                && memory.getSizeGB() >= 16;
    }

    @Override
    public String toString() {
        return "Компьютер " + brand + ":\n"
                + "  " + processor + "\n"
                + "  " + memory + "\n"
                + "  " + monitor;
    }
}

