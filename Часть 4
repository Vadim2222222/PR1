package seasons;

public enum Season {
    WINTER(-10) {
        // По умолчанию — "Холодное время года", ничего не меняем
    },
    SPRING(10) {
        // По умолчанию
    },
    SUMMER(25) {
        @Override
        public String getDescription() {
            return "Теплое время года";
        }
    },
    AUTUMN(8) {
        // По умолчанию
    };

    private final int averageTemperature;

    Season(int averageTemperature) {
        this.averageTemperature = averageTemperature;
    }

    public int getAverageTemperature() {
        return averageTemperature;
    }

    public String getDescription() {
        return "Холодное время года";
    }
}

package seasons;

public class TestSeason {
    public static void main(String[] args) {

        // 1. Переменная с любимым временем года
        Season favorite = Season.SUMMER;
        System.out.println("Моё любимое время года: " + favorite);
        System.out.println("Средняя температура: " + favorite.getAverageTemperature() + "°C");
        System.out.println("Описание: " + favorite.getDescription());

        // 2. Метод со switch
        System.out.println("\n=== Проверка switch ===");
        for (Season s : Season.values()) {
            printSeasonMessage(s);
        }

        // 3. Цикл по всем временам года с температурой и описанием
        System.out.println("\n=== Все времена года ===");
        for (Season s : Season.values()) {
            System.out.printf("%-8s | %3d°C | %s%n",
                    s, s.getAverageTemperature(), s.getDescription());
        }
    }

    // Метод со switch: если лето — "Я люблю лето" и т.д.
    public static void printSeasonMessage(Season season) {
        switch (season) {
            case WINTER:
                System.out.println("Зима: " + season.getDescription());
                break;
            case SPRING:
                System.out.println("Весна: " + season.getDescription());
                break;
            case SUMMER:
                System.out.println("Я люблю лето! " + season.getDescription());
                break;
            case AUTUMN:
                System.out.println("Осень: " + season.getDescription());
                break;
        }
    }
}

package shop;

public enum Category {
    ELECTRONICS,   // Электроника
    BOOKS,         // Книги
    CLOTHING       // Одежда
}

package shop;

import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Shop shop = new Shop();

        // 1. АУТЕНТИФИКАЦИЯ
        User user = new User("admin", "1234");
        System.out.println("Вход в интернет-магазин");
        System.out.print("Логин: ");
        String login = sc.nextLine();
        System.out.print("Пароль: ");
        String pwd = sc.nextLine();

        if (!login.equals(user.getLogin()) || !user.checkPassword(pwd)) {
            System.out.println("Неверный логин или пароль. Выход.");
            sc.close();
            return;
        }
        System.out.println("Добро пожаловать, " + login + "!\n");

        // ОСНОВНОЙ ЦИКЛ
        while (true) {
            System.out.println("\nМеню");
            System.out.println("1. Категории товаров");
            System.out.println("2. Товары категории");
            System.out.println("3. Добавить товар в корзину");
            System.out.println("4. Показать корзину");
            System.out.println("5. Купить");
            System.out.println("0. Выход");
            System.out.print("Ваш выбор: ");

            int choice;
            try {
                choice = Integer.parseInt(sc.nextLine());
            } catch (NumberFormatException e) {
                System.out.println("Ошибка: введите число.");
                continue;
            }

            switch (choice) {
                case 1:
                    shop.showCategories();
                    break;

                case 2:
                    shop.showCategories();
                    System.out.print("Введите название категории: ");
                    String catName = sc.nextLine().trim().toUpperCase();
                    try {
                        Category c = Category.valueOf(catName);
                        shop.showProducts(c);
                    } catch (IllegalArgumentException e) {
                        System.out.println("Такой категории нет. Попробуйте: "
                                + java.util.Arrays.toString(Category.values()));
                    }
                    break;

                case 3:
                    System.out.print("Введите название товара: ");
                    String productName = sc.nextLine().trim();
                    Product p = shop.findProduct(productName);
                    if (p != null) {
                        shop.addToCart(p);
                    } else {
                        System.out.println("Товар не найден.");
                    }
                    break;

                case 4:
                    shop.showCart();
                    break;

                case 5:
                    shop.checkout();
                    break;

                case 0:
                    System.out.println("До свидания!");
                    sc.close();
                    return;

                default:
                    System.out.println("Неверный выбор. Введите число от 0 до 5.");
            }
        }
    }
}

package shop;

public class Product {
    private String name;          // название
    private double price;         // цена
    private Category category;    // категория

    public Product(String name, double price, Category category) {
        this.name = name;
        this.price = price;
        this.category = category;
    }

    public String getName() { return name; }
    public double getPrice() { return price; }
    public Category getCategory() { return category; }

    @Override
    public String toString() {
        return name + " — " + price + " руб. [" + category + "]";
    }
}

package shop;

import java.util.ArrayList;
import java.util.List;

public class Shop {
    private List<Product> products = new ArrayList<>();   // каталог
    private List<Product> cart = new ArrayList<>();       // корзина

    // Конструктор заполняет каталог тестовыми товарами
    public Shop() {
        products.add(new Product("Смартфон", 25000, Category.ELECTRONICS));
        products.add(new Product("Ноутбук", 60000, Category.ELECTRONICS));
        products.add(new Product("Наушники", 3000, Category.ELECTRONICS));
        products.add(new Product("Роман «Мастер и Маргарита»", 800, Category.BOOKS));
        products.add(new Product("Учебник Java", 1500, Category.BOOKS));
        products.add(new Product("Футболка", 1200, Category.CLOTHING));
        products.add(new Product("Джинсы", 3500, Category.CLOTHING));
    }

    // 1. Показать все категории
    public void showCategories() {
        System.out.println("Доступные категории:");
        for (Category c : Category.values()) {
            System.out.println("  • " + c);
        }
    }

    // 2. Показать товары в категории
    public void showProducts(Category category) {
        System.out.println("Товары в категории " + category + ":");
        boolean found = false;
        for (Product p : products) {
            if (p.getCategory() == category) {
                System.out.println("  " + p);
                found = true;
            }
        }
        if (!found) System.out.println("  (товаров нет)");
    }

    // 3. Найти товар по названию
    public Product findProduct(String name) {
        for (Product p : products) {
            if (p.getName().equalsIgnoreCase(name)) return p;
        }
        return null;
    }

    // 4. Добавить в корзину
    public void addToCart(Product p) {
        cart.add(p);
        System.out.println("Добавлено в корзину: " + p.getName());
    }

    // 5. Показать корзину
    public void showCart() {
        if (cart.isEmpty()) {
            System.out.println("Корзина пуста.");
            return;
        }
        System.out.println("В корзине:");
        for (Product p : cart) System.out.println("  " + p);
    }

    // 6. Купить
    public void checkout() {
        if (cart.isEmpty()) {
            System.out.println("Корзина пуста — покупать нечего.");
            return;
        }
        double total = 0;
        System.out.println("Оформление покупки");
        for (Product p : cart) {
            System.out.println("  " + p);
            total += p.getPrice();
        }
        System.out.println("Итого: " + total + " руб.");
        cart.clear();
        System.out.println("Покупка завершена. Корзина очищена.");
    }
}

